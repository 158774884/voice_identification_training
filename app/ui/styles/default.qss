/*
 * VoiceModelTool — Default QSS Stylesheet
 * Clean, modern light theme with blue accents.
 */

/* ===== Global ===== */
QMainWindow {
    background-color: #f5f6fa;
}

QWidget {
    font-family: "Microsoft YaHei", "Segoe UI", "PingFang SC", sans-serif;
    font-size: 13px;
    color: #2c3e50;
}

/* ===== Menu Bar ===== */
QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e0e4e8;
    padding: 2px 0;
}
QMenuBar::item {
    padding: 6px 14px;
    background: transparent;
    border-radius: 4px;
    margin: 2px 2px;
}
QMenuBar::item:selected {
    background-color: #e8f0fe;
    color: #1a73e8;
}
QMenu {
    background-color: #ffffff;
    border: 1px solid #e0e4e8;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 32px 6px 20px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #e8f0fe;
    color: #1a73e8;
}
QMenu::separator {
    height: 1px;
    background: #e0e4e8;
    margin: 4px 8px;
}

/* ===== Tool Bar ===== */
QToolBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e0e4e8;
    padding: 2px 6px;
    spacing: 4px;
}
QToolBar::separator {
    width: 1px;
    background: #e0e4e8;
    margin: 4px 4px;
}
QToolButton {
    padding: 6px 12px;
    border-radius: 4px;
    border: 1px solid transparent;
}
QToolButton:hover {
    background-color: #e8f0fe;
    border-color: #c4d7f2;
}
QToolButton:pressed {
    background-color: #d2e3fc;
}

/* ===== Tab Widget ===== */
QTabWidget::pane {
    border: none;
    background-color: #f5f6fa;
}
QTabBar::tab {
    background-color: #e8ecf1;
    border: none;
    padding: 10px 20px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-size: 13px;
    color: #5f6368;
}
QTabBar::tab:selected {
    background-color: #ffffff;
    color: #1a73e8;
    font-weight: bold;
}
QTabBar::tab:hover:!selected {
    background-color: #dde3ea;
}

/* ===== Group Box ===== */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e0e4e8;
    border-radius: 8px;
    margin-top: 12px;
    padding: 16px 12px 12px 12px;
    font-weight: bold;
    font-size: 14px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 10px;
    background-color: #ffffff;
    border-radius: 4px;
}

/* ===== Buttons ===== */
QPushButton {
    background-color: #1a73e8;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 18px;
    font-weight: bold;
    min-height: 20px;
}
QPushButton:hover {
    background-color: #1557b0;
}
QPushButton:pressed {
    background-color: #0d47a1;
}
QPushButton:disabled {
    background-color: #c4c7cc;
    color: #909499;
}
QPushButton#secondaryBtn {
    background-color: #ffffff;
    color: #1a73e8;
    border: 1px solid #1a73e8;
}
QPushButton#secondaryBtn:hover {
    background-color: #e8f0fe;
}
QPushButton#dangerBtn {
    background-color: #dc3545;
}
QPushButton#dangerBtn:hover {
    background-color: #c82333;
}
QPushButton#successBtn {
    background-color: #28a745;
}
QPushButton#successBtn:hover {
    background-color: #218838;
}

/* ===== Inputs ===== */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    border: 1px solid #d0d5dd;
    border-radius: 6px;
    padding: 6px 10px;
    background-color: #ffffff;
    min-height: 20px;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #1a73e8;
    outline: none;
}
QComboBox::drop-down {
    border: none;
    padding-right: 6px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #e0e4e8;
    border-radius: 4px;
    selection-background-color: #e8f0fe;
    selection-color: #2c3e50;
}

/* ===== Sliders ===== */
QSlider::groove:horizontal {
    background: #d0d5dd;
    height: 6px;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #1a73e8;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}
QSlider::sub-page:horizontal {
    background: #1a73e8;
    border-radius: 3px;
}

/* ===== Table View ===== */
QTableView {
    background-color: #ffffff;
    border: 1px solid #e0e4e8;
    border-radius: 6px;
    gridline-color: #f0f0f0;
    selection-background-color: #e8f0fe;
    selection-color: #2c3e50;
}
QTableView::item {
    padding: 4px 8px;
}
QHeaderView::section {
    background-color: #f8f9fa;
    border: none;
    border-bottom: 2px solid #e0e4e8;
    padding: 8px 8px;
    font-weight: bold;
    color: #5f6368;
}

/* ===== Plain Text (Logs, Terminal) ===== */
QPlainTextEdit {
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: 1px solid #333;
    border-radius: 6px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    selection-background-color: #264f78;
}

/* ===== Scroll Area ===== */
QScrollArea {
    border: none;
    background: transparent;
}

/* ===== Progress Bar ===== */
QProgressBar {
    border: none;
    border-radius: 4px;
    background-color: #e0e4e8;
    height: 8px;
    text-align: center;
    font-size: 11px;
}
QProgressBar::chunk {
    background-color: #1a73e8;
    border-radius: 4px;
}

/* ===== Status Bar ===== */
QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #e0e4e8;
    padding: 2px 8px;
    font-size: 12px;
}

/* ===== Splitter ===== */
QSplitter::handle {
    background-color: #e0e4e8;
    width: 2px;
    height: 2px;
}

/* ===== Check Box ===== */
QCheckBox {
    spacing: 8px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 2px solid #d0d5dd;
}
QCheckBox::indicator:checked {
    background-color: #1a73e8;
    border-color: #1a73e8;
}

/* ===== Label ===== */
QLabel#titleLabel {
    font-size: 18px;
    font-weight: bold;
    color: #1a73e8;
}
QLabel#subtitleLabel {
    font-size: 14px;
    color: #5f6368;
}

/* ===== Tree View ===== */
QTreeView {
    background-color: #ffffff;
    border: 1px solid #e0e4e8;
    border-radius: 6px;
}
QTreeView::item:selected {
    background-color: #e8f0fe;
    color: #2c3e50;
}
